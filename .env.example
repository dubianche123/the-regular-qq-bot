# regular setup guides configuration and local checks; regular init creates a blank template.
# Real environment variables override .env.
QQ_APP_ID=
QQ_APP_SECRET=

# Generic OpenAI-compatible endpoint. Supply the URL, key and model explicitly.
AI_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=
# OPENAI_MODELS_DIGEST=your-digest-model
# OPENAI_MODELS_JUDGE=your-review-model

# Optional convenience presets; access and pricing depend on your account.
# AI_PROVIDER=zhipu
ZHIPU_API_KEY=
GEMINI_API_KEY=
# ZHIPU_MODELS=glm-4.7,glm-4.5-air,glm-4-flash
# ZHIPU_MODELS_DIGEST=glm-4.5-air,glm-4-flash
# ZHIPU_MODELS_JUDGE=glm-4.7
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# GEMINI_MODELS_DIGEST=gemini-3.5-flash-lite
# GEMINI_MODELS_JUDGE=gemini-3.5-flash-lite
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Each job can use its own provider (blank = AI_PROVIDER). Measured split on real
# group chat, 2026-11-01 (docs/model-roles.md): replies on a local gateway's
# glm-5.3-flash, digest on deepseek-v4.1-flash, nickname audit on OpenAI gpt-6-luna
# (it reasons; the audit is the one job where reasoning helps). For example:
#   AI_PROVIDER=zhipu  ZHIPU_BASE_URL=http://127.0.0.1:17863/v1
#   ZHIPU_MODELS=glm-5.3-flash  ZHIPU_MODELS_DIGEST=deepseek-v4.1-flash
#   JUDGE_PROVIDER=openai  OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_MODELS=gpt-6-luna
#   FALLBACK_PROVIDER=openai
# How each model must be called (token field, temperature, reasoning switch) lives in
# config.MODEL_PROFILES; unlisted models keep the old max_tokens + temperature request.
# CHAT_PROVIDER=
# DIGEST_PROVIDER=
# JUDGE_PROVIDER=
# Reasoning level per job, for models whose profile registers an effort field
# (gpt-6-luna: none/low/medium/high/xhigh). Blank keeps the old behaviour (only the
# audit reasons). Measured 2026-11-01: replies at low ranked first in a blind review;
# the digest at xhigh stopped writing sensitive nicknames into memory.
# CHAT_REASONING=low
# DIGEST_REASONING=xhigh
# JUDGE_REASONING=
# VISION_REASONING=
# Output cap when a model reasons. Reasoning spends the cap first; the digest at
# xhigh used ~7.5k reasoning tokens on a 339-message day.
# REASONING_MAX_TOKENS=16000
# The digest runs in the background; deep reasoning takes over a minute per call.
# DIGEST_TIMEOUT_SECONDS=240

# Only this explicitly selected fallback may receive prompts after provider errors.
# Configure its URL/models/key before enabling. Blank disables fallback.
FALLBACK_PROVIDER=
# AI_MAX_ATTEMPTS=3
# AI_TIMEOUT_SECONDS=20
# AI_TOTAL_TIMEOUT=30
# Output caps include reasoning tokens on thinking models (a cap, not a target).
# AI_MAX_TOKENS=768
# AI_MAX_TOKENS_BANTER=320
# JUDGE_MAX_TOKENS=400
# DIGEST_MAX_TOKENS=1200
# AI_TEMPERATURE=0.9

# The first nonempty C2C private message claims an unowned bot automatically.
# Limit QQ message-list access to the intended owner/testers before first use.
# Comma-separated aliases; blank recognizes only platform nickname/mentions.
BOT_NAMES=

# Keep state/log/archive/memory together in the deployment directory.
# DATA_DIR=data
# REGULAR_HOME=/absolute/path/to/deployment
# STATE_FILE=path/relative/to/deployment/state.json
SSL_VERIFY=true

# Image reading defaults to the main provider and its first chat model.
# Override these when the main model is text-only; set false to disable images.
VISION_ENABLED=true
# VISION_PROVIDER=openai
# VISION_MODEL=your-image-capable-model
# url passes a URL to the model; download fetches locally and sends base64 once.
# VISION_INPUT_MODE=url
# VISION_DAILY_CAP=30
# VISION_MAX_TOKENS=300

# Paid image generation defaults to enabled, with a separate daily cap. Uses
# IMAGE_GENERATION_API_KEY, then OPENAI_API_KEY / api_keys_openai.txt. For the
# official OpenAI endpoint only, it can also reuse an official decision API key.
# IMAGE_GENERATION_ENABLED=false
# IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
# IMAGE_GENERATION_API_KEY=
# IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
# IMAGE_GENERATION_QUALITY=medium
# IMAGE_GENERATION_SIZE=1024x1024
# IMAGE_GENERATION_DAILY_CAP=40
# IMAGE_GENERATION_TIMEOUT_SECONDS=150
# Per member in each group; extras apply at acquaintance/friend/buddy/soulmate tiers.
# IMAGE_USER_DAILY_CAP=5
# IMAGE_USER_EXTRA_ACQUAINTANCE=1
# IMAGE_USER_EXTRA_FRIEND=2
# IMAGE_USER_EXTRA_BUDDY=4
# IMAGE_USER_EXTRA_SOULMATE=8
# SEARCH_USER_DAILY_CAP=20
# SEARCH_USER_EXTRA_ACQUAINTANCE=5
# SEARCH_USER_EXTRA_FRIEND=10
# SEARCH_USER_EXTRA_BUDDY=20
# SEARCH_USER_EXTRA_SOULMATE=30

# On-demand recall reads local archive only when the user asks about the past.
# MEMORY_RECALL_ENABLED=true
# MEMORY_RECALL_MAX_ITEMS=2
# MEMORY_RECALL_LOOKBACK_DAYS=30
# Personal quotes require a source, the same speaker, a current topic match, and a fresh timestamp.
# Disable only their injection to compare with ordinary replies; names and game relations remain.
# PERSONAL_MEMORY_ENABLED=true
# PEOPLE_NOTE_MAX_AGE_DAYS=2
# Expression learning is a by-product of the daily digest; no extra model calls.
# STYLE_NOTE_MAX_ITEMS=5
# STYLE_MIN_REPEATS=2

# Interaction journal: incoming messages, gate decisions and delivered replies
# append to a separate interactions/ JSONL log, local only.
# It never enters prompts, digests or recall; disabling it writes no files.
# INTERACTION_LOG_ENABLED=true
# INTERACTION_LOG_DIR=interactions
# Observation schema tag stored on delivery rows; analysis-only, no behavior change.
# INTERACTION_POLICY_ID=regular-observe-v1

# Native GPT Decisions helper (POST /v1/decisions, not /chat/completions).
# Endpoint/model/key are saved via the panel "判断 API" page into
# data/decision_api.json; these flags only gate/timeout the calls.
# The decision payloads also declare the bot's own names (BOT_NAMES + platform
# nickname). Leave BOT_NAMES unset and a plain "小王闭嘴" is read as being about
# some other member, so the back-off window never arms — measured on real data,
# see docs/when-to-intervene.md. Set BOT_NAMES explicitly.
# DECISION_ENABLED=true
# DECISION_TIMEOUT_SECONDS=6
# Decisions get their own daily cap, separate from DAILY_BUDGET, so triaging
# every group message can never use up the budget for actual replies.
# DECISION_DAILY_BUDGET=5000
# Triage every group message (scrubbed of group/user/message IDs; anything that
# hits the word filter is never sent). Set false to only ask about messages that
# involve the bot. Private chats are never triaged.
# DECISION_TRIAGE_ALL=true
# DECISION_FEEDBACK_WINDOW_SECONDS=120
# DECISION_QUIET_SECONDS=180
# PEOPLE_DURABLE_MAX_AGE_DAYS=90
# PEOPLE_MEMORY_MAX_ITEMS=24

# When to interject. The opening prior re-weights the interjection dice by how
# open the conversational floor looks right now (local features only, no model
# call); the multiplier is normalised by this group's own mean score, so
# BANTER_PROBABILITY still sets total volume and the prior only moves *when*
# those messages land. Coefficients and holdout numbers: see opening.py.
# OPENING_PRIOR_ENABLED=true
# OPENING_SHAPE_MIN=0.40
# OPENING_SHAPE_MAX=2.00
# Every triaged group message also answers "would one unsolicited remark fit now?".
# Its p(join_briefly)^3, normalised by this group's own mean, multiplies the same
# dice (the verdict itself drifts with the scene: 37% "join" on archived chat,
# 0% on a night of people talking to the bot). Floor 0 lets a confident "no"
# silence a moment completely. See docs/when-to-intervene.md.
# INTERVENTION_SHAPE_MIN=0.0
# INTERVENTION_SHAPE_MAX=3.0

# Interjection receptiveness: natural feedback on uninvited interjections
# (annoyed vs. playing along) accumulates into one decaying scalar per person,
# shrunk toward the group. The personal estimate only changes behaviour when a
# cross-member permutation test (labels shuffled among the group's members)
# says this person really differs, with the chance of wrongly singling out
# anyone in the group held at RECEPTIVE_ALPHA; otherwise the multiplier is
# exactly 1.0. Never a lasting label, never a prompt.
# RECEPTIVE_ENABLED=true
# RECEPTIVE_PRIOR_WEIGHT=4
# RECEPTIVE_HALF_LIFE_DAYS=14
# RECEPTIVE_MIN_EVIDENCE=4
# RECEPTIVE_ALPHA=0.05
# RECEPTIVE_PERMUTATIONS=200
# RECEPTIVE_GAIN=1.5
# RECEPTIVE_MULTIPLIER_MIN=0.5
# RECEPTIVE_MULTIPLIER_MAX=1.5

# Remembering out loud: during an uninvited interjection the bot may bring up
# one of this person's own earlier quotes, gated by a native decision on whether
# it would land as recognition rather than reciting a file. Rare by design.
# DECISION_CALLBACK_ENABLED=true
# DECISION_CALLBACK_COOLDOWN_SECONDS=21600
# DECISION_CALLBACK_MAX_PER_DAY=2

# Abstention floor on native judgements. The returned probabilities are NOT
# calibrated (measured: ECE 0.22, Platt slope 0.21 — logits need ~5x shrinking),
# so absolute thresholds are meaningless. The scale-free margin (chosen option
# minus runner-up; empirically identical to the returned `confidence`) is used
# instead: below this floor the question is discarded and the caller falls back
# to baseline behaviour. Measured on 200 labelled real windows: discarding
# margin < 0.3 removed answers that were right 51.2% of the time (coin flips)
# and lifted the rest from 0.575 to 0.619 — but a HIGHER floor is worse
# (0.70 -> 0.559, below no abstention). It is a floor, not a confidence licence.
# Set 0 to disable. See docs/decision-calibration.md.
# DECISION_MIN_MARGIN=0.25

# Editable knowledge base: knowledge/all.md + knowledge/<group_id>.md.
# Keyword matches only; maintainers edit Markdown directly and changes apply next turn.
# KNOWLEDGE_ENABLED=true
# KNOWLEDGE_MAX_ITEMS=2
# KNOWLEDGE_MAX_CHARS=360

# Web lookup. With RESEARCH_PROVIDER set (an OpenAI-compatible Responses endpoint
# with web_search, e.g. openai + gpt-6-luna), the triage judgment decides when a
# reply addressed to the bot should look things up first, and "搜索 关键词" uses it
# too; without it, only the explicit command searches DuckDuckGo.
# Lookups that miss ASYNC_REPLY_SECONDS get a short "checking" reply first and a
# follow-up when the background job finishes (see docs/slow-work.md).
# RESEARCH_PROVIDER=openai
# RESEARCH_MODEL=gpt-6-luna
# ASYNC_REPLY_SECONDS=6
# Deep research is a hidden easter egg: only when someone explicitly asks the bot
# to investigate thoroughly; about a minute, delivered as a follow-up.
# DEEP_RESEARCH_ENABLED=true
# DEEP_RESEARCH_DAILY_CAP=3
# DEEP_RESEARCH_COOLDOWN_SECONDS=600
# SEARCH_ENABLED=true
# SEARCH_MAX_RESULTS=3
# SEARCH_TIMEOUT_SECONDS=8
# The cooldown applies to the explicit command only; the daily cap counts both.
# SEARCH_COOLDOWN_SECONDS=60
# SEARCH_DAILY_CAP=60
# Search connects directly by default; set this only when outbound HTTPS needs a proxy.
# SEARCH_PROXY=http://127.0.0.1:7890
# SEARCH_USE_ENV_PROXY=false

# Optional deployment proxy; no private address is injected into services.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Runtime defaults (guarded by tests/test_product_cli.py).
# BANTER_PROBABILITY=0.12
# OWNER_MENTION_PROBABILITY=0.30
# BANTER_COOLDOWN_SECONDS=120
# DAILY_BUDGET=3000
# LOG_LEVEL=INFO
